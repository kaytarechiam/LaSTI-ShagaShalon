{
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p reservation-react/tsconfig.json",
    "build:app": "npm run typecheck && vite build",
    "preserve": "npm run build:app",
    "serve": "node serve.js",
    "db:init:dev": "node backend/postgres/init-dev.js",
    "db:smoke:dev": "node ../tests/integration/neon-smoke.mjs",
    "db:seed:demo": "node backend/postgres/seed-demo.js",
    "db:create:team": "node backend/postgres/create-team.js",
    "test": "node --test ../tests/unit/*.test.mjs ../tests/integration/*.test.mjs ../tests/integration/reservation-confirmation/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
